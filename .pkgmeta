# What the BigWigs packager puts in the release zip (.github/workflows/release.yml).
# Files starting with a dot (.github, .pkgmeta) are left out on their own.
package-as: GamepadCameraOffset

# Comments only on their own line: the packager reads anything after an item as part of it.
ignore:
  # the CurseForge page material: its text, gallery screenshots, icon sources
  - Data
  - tests
  # /gpco debug, the in-game test suite; its .toc line is in a do-not-package block
  - Code/Debug.lua
  # watches hold & drag on screen (dev builds only)
  - Code/DebugKeys.lua
  # checks whether controller override bindings reach the addon (dev builds only)
  - Code/DebugPadProbe.lua
  # measures how far the camera goes to each side, with screenshots (dev builds only)
  - Code/DebugSideProbe.lua
  # whether moving the WorldFrame moves the picture up or down, with screenshots (dev builds only)
  - Code/DebugWorldFrameProbe.lua

# The changelog shown with each release: written by hand, not built from commit messages.
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown
